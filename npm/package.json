{
  "name": "molt",
  "version": "1.0.1",
  "description": "Fast, type-safe HTML generation in WebAssembly. A port of Winged-Swift.",
  "license": "MIT",
  "author": "Michel Anderson Lutz Teixeira <michel@micheltlutz.me>",
  "homepage": "https://github.com/micheltlutz/molt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/micheltlutz/molt.git"
  },
  "bugs": {
    "url": "https://github.com/micheltlutz/molt/issues"
  },
  "keywords": [
    "html",
    "wasm",
    "webassembly",
    "ssg",
    "templating",
    "rust"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./node/molt.js",
  "module": "./bundler/molt.js",
  "types": "./bundler/molt.d.ts",
  "exports": {
    ".": {
      "types": "./bundler/molt.d.ts",
      "node": "./node/molt.js",
      "browser": "./web/molt.js",
      "default": "./bundler/molt.js"
    },
    "./web": {
      "types": "./web/molt.d.ts",
      "default": "./web/molt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "node",
    "web",
    "bundler",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
